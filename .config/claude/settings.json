{
  "tui": "fullscreen",
  "editorMode": "vim",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/block-dangerous-git"
          },
          {
            "type": "command",
            "command": "./hooks/block-tsc"
          },
          {
            "type": "command",
            "command": "./hooks/block-npx-jest"
          },
          {
            "type": "command",
            "command": "./hooks/block-npx-vitest"
          },
          {
            "type": "command",
            "command": "./hooks/block-pnpm-filter-double-dash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
