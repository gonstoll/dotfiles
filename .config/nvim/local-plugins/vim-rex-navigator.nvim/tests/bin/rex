#!/bin/sh
# Fake rex for tests: records each call's arguments, then answers from the
# fixture files in $REX_FAKE_DIR. Arguments are separated by \037 and calls
# by \036, because arguments may contain newlines.
for arg in "$@"; do
	printf '%s\037' "$arg" >>"$REX_FAKE_DIR/calls"
done
printf '\036' >>"$REX_FAKE_DIR/calls"

if [ -f "$REX_FAKE_DIR/fail" ]; then
	cat "$REX_FAKE_DIR/fail" >&2
	exit 1
fi

case "$1 $2 $3" in
"api call -s")
	if [ -f "$REX_FAKE_DIR/view.json" ]; then
		cat "$REX_FAKE_DIR/view.json"
	else
		printf '{"active_window_id":"window:1","windows":[{"window_id":"window:1"}]}'
	fi
	;;
*) printf '{}' ;;
esac
