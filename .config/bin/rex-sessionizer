#!/usr/bin/env bash

# Rex starts this without a login shell, so Homebrew's tools aren't on PATH yet.
export PATH="/opt/homebrew/bin:$PATH"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DIRECTORIES=($(eval echo $(xargs < "$CONFIG_HOME/rex-sessionizer/directories")))

function list_directories() {
    find "${DIRECTORIES[@]}" -mindepth 1 -maxdepth 1 -type d
}

if [[ "$1" == "--list" ]]; then
    list_directories
    exit 0
fi

selected=$(list_directories | fzf \
        --style minimal \
        --no-bold \
        --height=100% \
        --no-color \
        --border rounded \
        --border-label " sessionizer " \
    )

# Rex keeps a pane open after a quick failure, so cancelling must exit 0 for the popup to close.
if [[ -z "$selected" ]]; then
    exit 0
fi

if ! rex do open_project dir="$selected"; then
    read -r -p "Press Enter to close"
    exit 1
fi
